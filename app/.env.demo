# ==========================================
# MD系统提示词配置
# ==========================================
MD_FOLDER=./new_human_soul


# ==========================================
# 向量知识库配置
# ==========================================

# 知识库存储路径（持久化目录）
KB_PERSIST_DIR=./my_knowledge_bases




# ==========================================
# 向量嵌入模型配置
# ==========================================

# 嵌入模型名称
EMBEDDING_MODEL=xxx
# API基础URL
EMBEDDING_BASE_URL=https://xxx
# API密钥
EMBEDDING_API_KEY=sk-xxx
# API类型 (openai/bailian/deepseek)
EMBEDDING_API_TYPE=openai

# ==========================================
# 大语言模型配置
# ==========================================

# 模型名称
LLM_MODEL_NAME=xxx
# API基础URL
LLM_MODEL_BASE_URL=https://xxx
# API密钥
LLM_MODEL_API_KEY=sk-xxx
# API类型 (openai/bailian)
LLM_MODEL_API_TYPE=openai


# ==========================================
# LANGSMITH监控配置
# ==========================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="xxx"
LANGSMITH_PROJECT="xxx"
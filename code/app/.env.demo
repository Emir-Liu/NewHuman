# ==========================================
# NACOS 配置（本地开发建议关闭）
# ==========================================
NACOS_ENABLED=false
NACOS_SERVER_ADDRESSES=http://192.168.0.10:8848
NACOS_NAMESPACE=public
NACOS_SERVICE_NAME=ai-knowledge
NACOS_GROUP=DEFAULT_GROUP
NACOS_CLUSTER_NAME=DEFAULT
NACOS_WEIGHT=1


# ==========================================
# 关系数据库配置 (存储知识库元数据、文档元数据)
# ==========================================

# 数据库类型 (sqlite / postgresql / mysql)
DATABASE_TYPE=sqlite

# SQLite 数据库文件路径（DATABASE_TYPE=sqlite 时生效）
# 默认: ./data/knowledge_base.db
SQLITE_DB_PATH=./data/relational/knowledge_base.db

# 通用数据库连接 URL（DATABASE_TYPE=postgresql/mysql 时生效）
# PostgreSQL 格式: postgresql://user:password@host:port/dbname
# MySQL 格式: mysql://user:password@host:port/dbname
# DATABASE_URL=

# 数据库连接参数（非 SQLite 时使用，DATABASE_URL 未设置时生效）
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=knowledge_base

# 连接池配置
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=10

# 打印 SQL 日志（调试用，生产环境请关闭）
# DB_ECHO_SQL=false


# ==========================================
# 向量知识库配置 (存储文档向量数据)
# ==========================================

# 向量库类型 (chroma / milvus)
VECTOR_STORE_TYPE=chroma

# 知识库存储路径（持久化目录）
KB_PERSIST_DIR=./data/vector

# Milvus 连接配置（VECTOR_STORE_TYPE=milvus 时生效）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_USER=
# MILVUS_PASSWORD=
# MILVUS_SECURE=false
# MILVUS_DATABASE=default

# ==========================================
# 向量嵌入模型配置
# ==========================================

# 嵌入模型名称
EMBEDDING_MODEL=xxx
# API基础URL（vLLM 可写 http://host:port 或 http://host:port/v1，程序会自动补全 /v1）
EMBEDDING_BASE_URL=https://xxx
# API密钥
EMBEDDING_API_KEY=sk-xxx
# API类型 (openai/bailian/ollama/vllm)
EMBEDDING_API_TYPE=openai
# 向量化文本最大长度（token 数），留空表示不限制
EMBEDDING_MAX_LENGTH=400

# ==========================================
# 大语言模型配置
# ==========================================

# 模型名称
LLM_MODEL_NAME=xxx
# API基础URL
LLM_MODEL_BASE_URL=https://xxx
# API密钥
LLM_MODEL_API_KEY=sk-xxx
# API类型 (openai/bailian/ollama/vllm/cursor)
LLM_MODEL_API_TYPE=openai

# --- Cursor 模型（api_type=cursor 时启用，取消注释并填写）---
# 官方 api.cursor.com 仅提供 Agents API，无直接 chat/completions；
# 需配合 OpenAI 兼容本地代理（如 cursor-openai-api）或自定义 gateway。
# LLM_MODEL_API_TYPE=cursor
# LLM_MODEL_API_KEY=          # 或单独设置 CURSOR_API_KEY（Cursor 惯例）
# CURSOR_API_KEY=
# LLM_MODEL_BASE_URL=http://127.0.0.1:8765/v1   # 指向兼容代理的 /v1 前缀
# CURSOR_API_BASE_URL=        # 可选；未设 base_url 时作 fallback（仅 host，如 https://api.cursor.com）
# LLM_MODEL_NAME=composer-2.5 # 或 auto；可用 list_cursor_models() / GET /v1/models 查询

# ==========================================
# 日志相关配置
# ==========================================
LOG_LEVEL="INFO"
LOG_FOLDER_PATH="./logs"

# ==========================================
# LANGSMITH监控配置
# ==========================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="xxx"
LANGSMITH_PROJECT="xxx"

# ==========================================
# LANGFUSE监控配置
# ==========================================
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY="sk-lf-e7a62617-52e3-4dbd-8359-704a0c9899be"
LANGFUSE_PUBLIC_KEY="pk-lf-513b8881-373b-41cb-8144-f715ef010b9d"
LANGFUSE_BASE_URL="http://localhost:3000"

# langchain全局调试
LANGCHAIN_VERBOSE=true


# 服务配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# ==========================================
# Agent 配置
# ==========================================
# 发给 LLM 的最近对话轮数（按用户消息计）；0 表示不裁剪
AGENT_MAX_HISTORY_TURNS=3

# 子 Agent 最大嵌套深度（MVP 建议 1：主 Agent 可委派，子 Agent 不可再委派）
AGENT_MAX_SUBAGENT_DEPTH=1

# 单次 delegate_subagent 超时（秒）
SUBAGENT_TIMEOUT_SEC=120

# 每轮对话自动写入记忆文件（true/false）
CONVERSATION_MEMORY_ENABLED=true

# 对话记录目录（相对 workspace 根），默认 memory/conversations
# CONVERSATION_MEMORY_DIR=memory/conversations

# fetch_url 超时（秒）与最大响应字节
FETCH_URL_TIMEOUT=15
FETCH_URL_MAX_BYTES=524288